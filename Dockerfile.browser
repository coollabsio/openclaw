FROM lscr.io/linuxserver/chromium:latest

# Selkies already runs nginx. Its svc-nginx runbook kills every nginx process
# and the master uses /run/nginx.pid, so a second CDP nginx never stays up.
# conf.d is included by that existing server and is left alone by init-nginx.
COPY browser/cdp-proxy.conf /etc/nginx/conf.d/cdp-proxy.conf

# Always pass a DevTools port. CHROME_CLI is appended and can still override it.
RUN mv /usr/bin/wrapped-chromium /usr/bin/wrapped-chromium.real
COPY browser/wrapped-chromium /usr/bin/wrapped-chromium
RUN chmod 755 /usr/bin/wrapped-chromium && nginx -t
