FROM lscr.io/linuxserver/chromium:latest

# Chromium keeps CDP on 127.0.0.1:9222 even with --remote-debugging-address=0.0.0.0
# (issue #45). Other containers reach this proxy on 9223 instead.
# Host localhost:9222 makes Chrome accept the connection and advertise that port.
# Clearing Origin avoids Chrome 111+ rejecting OpenClaw's websocket handshake
# (403) when the client Origin is http://browser:9223.
# svc-nginx kills every nginx process it finds at startup, so this service
# starts after that and uses its own pid file.
RUN mkdir -p /etc/s6-overlay/s6-rc.d/nginx-cdp/dependencies.d \
    && echo "longrun" > /etc/s6-overlay/s6-rc.d/nginx-cdp/type \
    && printf '%s\n' '#!/command/execlineb -P' 'nginx -c /etc/nginx/cdp-proxy.conf -g "daemon off;"' > /etc/s6-overlay/s6-rc.d/nginx-cdp/run \
    && chmod +x /etc/s6-overlay/s6-rc.d/nginx-cdp/run \
    && touch /etc/s6-overlay/s6-rc.d/nginx-cdp/dependencies.d/svc-nginx \
    && touch /etc/s6-overlay/s6-rc.d/user/contents.d/nginx-cdp

RUN printf '%s\n' \
    'pid /run/nginx-cdp.pid;' \
    'error_log /dev/stderr;' \
    'events {}' \
    'http {' \
    '  server {' \
    '    listen 9223;' \
    '    location / {' \
    '      proxy_pass http://127.0.0.1:9222;' \
    '      proxy_set_header Host localhost:9222;' \
    '      proxy_set_header Origin "";' \
    '      proxy_http_version 1.1;' \
    '      proxy_set_header Upgrade $http_upgrade;' \
    '      proxy_set_header Connection "upgrade";' \
    '      proxy_read_timeout 86400s;' \
    '    }' \
    '  }' \
    '}' \
    > /etc/nginx/cdp-proxy.conf

# Chrome still checks Origin on a direct connection. Append the flag in the
# image so a compose file that only sets --remote-debugging-port keeps working.
RUN mv /usr/bin/wrapped-chromium /usr/bin/wrapped-chromium.real \
    && printf '%s\n' \
        '#!/bin/bash' \
        'exec /usr/bin/wrapped-chromium.real --remote-debugging-port=9222 --remote-allow-origins=* "$@"' \
        > /usr/bin/wrapped-chromium \
    && chmod +x /usr/bin/wrapped-chromium
